<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIApp.Pages.HomePage"
             Title="SnowPage">
    <VerticalStackLayout Padding="20">
        <Label Text="Tareas Pendientes" FontSize="20" FontAttributes="Bold" />
        <SearchBar x:Name="SearchBar" Placeholder="Buscar tarea..." TextChanged="OnSearchTextChanged"/>
        <Picker x:Name="FilterPicker" Title="Filtrar por estado" SelectedIndexChanged="OnFilterChanged">
            <Picker.Items>
                <x:String>Todas</x:String>
                <x:String>Completadas</x:String>
                <x:String>Pendientes</x:String>
            </Picker.Items>
        </Picker>
        <ListView x:Name="TaskListView"
          ItemsSource="{Binding FilteredTasks}"
          HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <HorizontalStackLayout Padding="5">
                            <CheckBox IsChecked="{Binding IsCompleted}"
                              CheckedChanged="OnTaskCompletedChanged"/>
                            <Label Text="{Binding Title}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaskTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Agregar Tarea" Clicked="OnAddTaskClicked" />
    </VerticalStackLayout>
</ContentPage>