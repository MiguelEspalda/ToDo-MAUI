<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIApp.Pages.HomePage"
             Title="SnowPage">
    <VerticalStackLayout Padding="20">
        <Picker x:Name="SortPicker" 
                Title="Ordenar Por" 
                SelectedIndexChanged="OnSortChanged">
            <Picker.Items>
                <x:String>Prioridad (Alta → Baja)</x:String>
                <x:String>Prioridad (Baja → Alta)</x:String>
                <x:String>Completadas primero</x:String>
                <x:String>Pendientes primero</x:String>
            </Picker.Items>
        </Picker>
        <Label Text="Tareas Pendientes" FontSize="20" FontAttributes="Bold" />
        <SearchBar x:Name="SearchBar" Placeholder="Buscar tarea..." TextChanged="OnSearchTextChanged"/>
        <ListView x:Name="TaskListView"
          ItemsSource="{Binding FilteredTasks}"
          HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <HorizontalStackLayout Padding="5">
                            <CheckBox IsChecked="{Binding IsCompleted}"
                              CheckedChanged="OnTaskCompletedChanged"/>
                            <Label Text="{Binding Title}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTaskTapped"/>
                                </Label.GestureRecognizers>
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextColor">
                                            <Setter.Value>
                                                <Binding Path="Priority" Converter="{StaticResource PriorityColorConverter}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </HorizontalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Agregar Tarea" Clicked="OnAddTaskClicked" />
    </VerticalStackLayout>
</ContentPage>